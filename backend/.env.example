# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://anubhav2402.github.io

# ── Twitter / X credentials (for twikit scraping) ────────────────────────────
TWITTER_USERNAME=your_twitter_username
TWITTER_EMAIL=your_twitter_email@example.com
TWITTER_PASSWORD=your_twitter_password

# ── Buzz engine ───────────────────────────────────────────────────────────────
BUZZ_THRESHOLD=3           # min unique accounts mentioning same stock to trigger alert
BUZZ_WINDOW_HOURS=24       # lookback window in hours

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCRAPE_INTERVAL_MINUTES=30   # how often to scrape Twitter accounts
NEWS_INTERVAL_MINUTES=15     # how often to refresh RSS news feeds

# ── Optional (not required for Phase 1) ──────────────────────────────────────
FMP_API_KEY=
